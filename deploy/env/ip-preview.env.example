# Temporary server-only preview without a domain name.
# Keep this file outside Git and use it only for non-sensitive testing data.

DEPLOY_ENV=dev
TRAVEL_API_IMAGE=ghcr.io/REPLACE_WITH_OWNER/travel-api:sha-REPLACE_WITH_COMMIT
TRAVEL_EDGE_IMAGE=ghcr.io/REPLACE_WITH_OWNER/travel-edge:sha-REPLACE_WITH_COMMIT
APP_ENV=development
APP_NAME=Travel Copilot IP Preview
FRONTEND_ORIGIN=http://REPLACE_WITH_SERVER_IP

POSTGRES_DB=travel_dev
POSTGRES_USER=travel_dev
POSTGRES_PASSWORD=REPLACE_WITH_SERVER_DATABASE_PASSWORD

SESSION_TTL_DAYS=7
AUTH_COOKIE_NAME=travel_session
AUTH_COOKIE_SAMESITE=lax

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_WITH_SERVER_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKEN=1000

# Configure both prices together or leave both commented out.
# LLM_INPUT_COST_PER_MILLION_USD=
# LLM_OUTPUT_COST_PER_MILLION_USD=
