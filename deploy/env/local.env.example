# Copy this file to the repository root as .env for local production-style testing.
# Never commit the copied file or reuse server secrets in this environment.

DEPLOY_ENV=dev
TRAVEL_API_IMAGE=travel-api:dev
TRAVEL_EDGE_IMAGE=travel-edge:dev
APP_ENV=development
APP_NAME=Travel Copilot Local
FRONTEND_ORIGIN=http://localhost

POSTGRES_DB=travel_dev
POSTGRES_USER=travel_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

SESSION_TTL_DAYS=7
AUTH_COOKIE_NAME=travel_session
AUTH_COOKIE_SAMESITE=lax

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_WITH_LOCAL_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKEN=1000

# Configure both prices together or leave both commented out.
# LLM_INPUT_COST_PER_MILLION_USD=
# LLM_OUTPUT_COST_PER_MILLION_USD=
