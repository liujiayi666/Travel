# Keep the copied file outside Git, for example /opt/travel/prod/app/.env.
# Never commit the copied file or share production secrets with dev.

DEPLOY_ENV=prod
TRAVEL_API_IMAGE=ghcr.io/REPLACE_WITH_OWNER/travel-api:sha-REPLACE_WITH_COMMIT
TRAVEL_EDGE_IMAGE=ghcr.io/REPLACE_WITH_OWNER/travel-edge:sha-REPLACE_WITH_COMMIT
APP_ENV=production
APP_NAME=Travel Copilot
FRONTEND_ORIGIN=https://example.com

# Docker Compose uses these values to initialize and connect to the production database.
# Use a generated URL-safe password, for example 32 random letters and digits.
POSTGRES_DB=travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=REPLACE_WITH_PROD_DATABASE_PASSWORD

SESSION_TTL_DAYS=7
AUTH_COOKIE_NAME=travel_session
AUTH_COOKIE_SAMESITE=lax

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_WITH_PROD_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKEN=1000

# Optional, but required when trace cost estimates should be available.
# Configure both prices together or leave both commented out.
# LLM_INPUT_COST_PER_MILLION_USD=
# LLM_OUTPUT_COST_PER_MILLION_USD=
