DATABASE_URL=postgresql+psycopg_async://travel:travel@localhost:5432/travel
SESSION_TTL_DAYS=7
APP_ENV="development"
AUTH_COOKIE_NAME="session"
AUTH_COOKIE_SAMESITE="lax"
FRONTEND_ORIGIN="http://localhost:5173"



# 当前默认使用哪个 Provider
LLM_PROVIDER=deepseek

